# Pollaris API Keys
# Copy this file to .env and fill in your actual keys

# Groq API Key (Get it from console.groq.com)
GROQ_API_KEY=your_groq_api_key_here

# Google Maps API Key (Optional, for booth search)
GOOGLE_MAPS_API_KEY=your_google_maps_key_here

# Database URL (Default is local sqlite)
DATABASE_URL=sqlite+aiosqlite:///./pollaris.db
